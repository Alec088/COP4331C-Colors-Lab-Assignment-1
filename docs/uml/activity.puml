@startuml activity
title Colors Web Application - Activity Diagram

|User|
start
:Open index.html;
:Enter username and password;
:Click "Do It";

|Browser (code.js)|
:doLogin(): clear userId, firstName, lastName;
:POST {login, password} to Login.php;

|Server (PHP API)|
:Login.php: decode JSON request;
if (DB connection OK?) then (yes)
  |MySQL Database|
  :SELECT ID, firstName, lastName FROM Users
  WHERE Login = ? AND Password = ?;
  |Server (PHP API)|
  if (Row found?) then (yes)
    :Return {id, firstName, lastName, error: ""};
  else (no)
    :Return {id: 0, error: "No Records Found"};
  endif
else (no)
  :Return {id: 0, error: connect_error};
endif

|Browser (code.js)|
if (userId < 1?) then (yes)
  :Show "User/Password combination incorrect";
  stop
else (no)
  |Browser (code.js)|
  :saveCookie(): firstName, lastName, userId
  (expires in 20 minutes);
  :Redirect to color.html;
endif

:On DOMContentLoaded: readCookie();
if (userId found in cookie?) then (no)
  :Redirect to index.html;
  stop
else (yes)
  |Browser (code.js)|
endif

|User|
repeat
  :Choose an action;
  if (Action?) then (Search Color)
    :Enter search text, click "Search Color";
    |Browser (code.js)|
    :searchColor(): POST JSON {search, userId} to
    SearchColors.php;
    |Server (PHP API)|
    :SearchColors.php: decode JSON request;
    |MySQL Database|
    :SELECT Name FROM Colors
    WHERE Name LIKE '%search%' AND UserID = ?;
    |Server (PHP API)|
    if (Any matches?) then (yes)
      :Return {results: [names], error: ""};
    else (no)
      :Return {id: 0, empty firstName/lastName,
      error: "No Records Found"};
    endif
    |Browser (code.js)|
    :Show "Color(s) has been retrieved";
    :Render results in <p id="colorList">;
    note right
      With no matches the response has no
      "results" array, so rendering fails and
      the old list stays on screen.
    end note
  else (Add Color)
    |User|
    :Enter color name, click "Add Color";
    |Browser (code.js)|
    :addColor(): POST JSON {color, userId} to
    AddColor.php;
    |Server (PHP API)|
    :AddColor.php: decode JSON request;
    |MySQL Database|
    :INSERT INTO Colors (UserId, Name)
    VALUES (?, ?);
    |Server (PHP API)|
    :Return {error: ""};
    |Browser (code.js)|
    :Show "Color has been added";
  endif
  |User|
repeat while (Log out?) is (no)
->yes;
|Browser (code.js)|
:doLogout(): reset user variables, expire cookie;
:Redirect to index.html;
|User|
stop
@enduml
